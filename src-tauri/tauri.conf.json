{
  "productName": "FilePulse",
  "version": "0.1.0",
  "identifier": "com.filepulse.app",
  "build": {
    "frontendDist": "../frontend",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "FilePulse - 文件脉搏",
        "width": 950,
        "height": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both"
      }
    }
  }
}
